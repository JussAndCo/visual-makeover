PORT=4173

# Production identity: put the app behind Cloudflare Access.
# Example: myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Access application AUD tag from Cloudflare Zero Trust.
CF_ACCESS_AUD=

# Preferred Opera bridge.
OPERA_BRIDGE_URL=
OPERA_BRIDGE_TOKEN=
# Runtime evidence only; these do not grant authority.
OPERA_CONNECTOR_AVAILABLE=
OPERA_LIVE_SESSION_EXPOSED=

# Optional alternate authenticated browser bridge.
ALT_AUTH_BROWSER_AVAILABLE=
ALT_AUTH_BROWSER_LIVE=
ALT_AUTH_BROWSER_BRIDGE_URL=
ALT_AUTH_BROWSER_BRIDGE_TOKEN=

# Optional bounded generic browser bridge.
GENERIC_BROWSER_AVAILABLE=
GENERIC_BROWSER_BRIDGE_URL=
GENERIC_BROWSER_BRIDGE_TOKEN=
