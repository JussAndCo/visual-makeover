PORT=4173

# Production identity: put the app behind Cloudflare Access.
# Example: myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Access application AUD tag from Cloudflare Zero Trust.
CF_ACCESS_AUD=

# Optional owner-controlled bridge that maps {tool,args} to the Opera MCP runtime.
OPERA_BRIDGE_URL=
OPERA_BRIDGE_TOKEN=
